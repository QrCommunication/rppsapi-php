{
    "name": "qrcommunication/rppsapi",
    "description": "SDK PHP pour interroger toutes les sources de données RPPS (Répertoire Partagé des Professionnels de Santé) de l'Annuaire Santé - ANS",
    "type": "library",
    "license": "PolyForm-Noncommercial-1.0.0",
    "keywords": [
        "rpps",
        "annuaire-sante",
        "ans",
        "fhir",
        "hl7",
        "professionnel-sante",
        "data-gouv",
        "france",
        "healthcare",
        "medecin",
        "pharmacien"
    ],
    "authors": [
        {
            "name": "QrCommunication",
            "email": "contact@qrcommunication.com"
        }
    ],
    "homepage": "https://github.com/QrCommunication/rppsapi-php",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/promises": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "QrCommunication\\RppsApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QrCommunication\\RppsApi\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
